{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": ["backend/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "vitest.config.ts"]
}
